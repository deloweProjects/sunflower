{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "frontend",
  "routes": [
    { "src": "^/$", "has": [{ "type": "host", "value": "linc.sunflower.co.zw" }], "dest": "/linc/index.html" },
    { "src": "^/(?!linc/)(.*)$", "has": [{ "type": "host", "value": "linc.sunflower.co.zw" }], "dest": "/linc/$1" },
    { "handle": "filesystem" }
  ]
}
